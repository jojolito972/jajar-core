# Copie ce fichier en ".env" (sans ".example") et remplis tes propres valeurs.
# Ne partage JAMAIS ton .env rempli, ne le commite JAMAIS (voir .gitignore).
#
# Rappel important (voir docs/SECURITY_INCIDENT.md) : le jeton Telegram de
# l'ancien projet a fuité en clair dans 15 fichiers du dépôt. Si tu réutilises
# le même bot, RÉVOQUE-LE d'abord via @BotFather avant de coller le nouveau
# jeton ici.

# --- Modèle local (facultatif) ----------------------------------------------
# D'après ce qu'on s'est dit : tu démarres avec Gemini cloud pour l'usage
# courant (GEMINI_API_KEY ci-dessous), et tu réserves le modèle local aux
# calculs du soir (sémantique du Second Cerveau, consolidation nocturne) —
# donc JARVIS_MODELE_LOCAL_DABORD=0 par défaut ici. Repasse-le à 1 quand ton
# serveur local tourne en continu et que tu veux aussi l'utiliser en journée.
LLAMA_API_BASE=http://localhost:8080/v1
LLAMA_MODEL_ID=gemma-4-12b-it
JARVIS_MODELE_LOCAL_DABORD=0

# --- Gemini cloud ------------------------------------------------------------
# Gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Embeddings pour la recherche sémantique du Second Cerveau --------------
# Laisse LLAMA_EMBEDDINGS_API_BASE vide pour utiliser Gemini cloud
# (gemini-embedding-001) — c'est le chemin qui marche dès aujourd'hui avec
# juste GEMINI_API_KEY rempli ci-dessus, rien d'autre à installer.
#
# Pour du 100% local le soir (le fameux "calcul du soir") : il faut un
# DEUXIÈME serveur llama.cpp, dédié, lancé avec --embeddings et un modèle
# d'embedding (le serveur de chat ci-dessus ne peut pas faire les deux à la
# fois — contrainte de llama.cpp, pas un choix arbitraire). Voir la note en
# bas de tools/second_cerveau.py pour la marche à suivre complète.
LLAMA_EMBEDDINGS_API_BASE=
LLAMA_EMBEDDINGS_MODEL_ID=nomic-embed-text

# --- Telegram (mode `python run_jarvis.py telegram`) -----------------------
# Jeton obtenu auprès de @BotFather (commande /newbot, ou /mybots pour un
# bot existant -> API Token -> Revoke current token si tu suspectes une fuite)
TELEGRAM_TOKEN=
# OBLIGATOIRE dès qu'un vrai jeton est renseigné (config.py refuse de démarrer
# le mode Telegram sans ça — un bot avec accès shell ne doit jamais être
# ouvert à n'importe qui). Identifiants séparés par des virgules.
# Lance le bot une première fois avec une liste vide, envoie /whoami depuis
# ton propre compte pour connaître ton identifiant, colle-le ici, relance.
TELEGRAM_ALLOWED_USER_IDS=

# --- Herdr (mode `python run_jarvis.py herdr <persona>`) -------------------
# Injectées automatiquement PAR Herdr dans chaque pane — rien à remplir ici,
# laissées en commentaire pour référence :
# HERDR_ENV=1
# HERDR_PANE_ID=...

# --- Voix Kokoro-82M (facultatif) -------------------------------------------
KOKORO_LANGUE=fr
KOKORO_VOIX=ff_siwis
VOIX_TTS_SECOURS=Thomas

# --- Second Cerveau / mémoire ------------------------------------------------
SEUIL_CONTEXTE_ALERTE=0.5
SEUIL_CONTEXTE_COMPRESSION=0.35

# --- Divers ------------------------------------------------------------------
JARVIS_UTILISATEUR=Denis
JARVIS_TIMEOUT_COMMANDE=60
